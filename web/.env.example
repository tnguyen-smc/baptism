# Copy to .env.local for local development (npm run dev).
# In production these come from GitHub → Settings → Secrets and variables → Actions → Variables.
# Both values are public by design; no secret ever goes in the frontend.

# The Apps Script web-app URL ending in /exec (Deploy → Manage deployments).
VITE_API_URL=https://script.google.com/macros/s/XXXXXXXX/exec

# OAuth 2.0 Web client id from Google Cloud Console (the Marriage Prep one works).
# Its "Authorized JavaScript origins" must include https://tnguyen-smc.github.io and http://localhost:5173
VITE_GOOGLE_CLIENT_ID=1234567890-xxxxxxxx.apps.googleusercontent.com
